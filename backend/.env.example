# ==============================================================================
# InsecurePay - Variables de entorno del backend (copiar a .env y NO versionar)
# ==============================================================================

# Secreto HMAC-SHA256 para firmar JWT: minimo 32 bytes (256 bits) aleatorios.
# Generar con:  openssl rand -base64 48
# Si se omite, el backend genera una clave aleatoria efimera en cada arranque.
JWT_SECRET=

# Vigencia del token en milisegundos (por defecto 1 hora)
JWT_EXPIRATION_MS=3600000

# Origenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Consola H2 (solo depuracion local; nunca en produccion)
H2_CONSOLE_ENABLED=false
